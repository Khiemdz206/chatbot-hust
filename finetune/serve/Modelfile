# Tạo model Ollama từ file GGUF đã fine-tune.
#
#   ollama create chatbot-hust -f Modelfile
#   ollama run chatbot-hust "xin chào"        # thử nhanh
#
# Sau đó backend gọi qua http://localhost:11434/v1 (chuẩn OpenAI), xem docs/14-finetune.md.
#
# Sửa đường dẫn dưới thành file .gguf thật (tên file do Unsloth đặt khi xuất).
# Nếu thư mục xuất của Unsloth đã có sẵn một Modelfile (kèm TEMPLATE đúng chat template),
# hãy dùng file đó thay cho file này.

FROM ./chatbot-hust-lora-gguf/unsloth.Q4_K_M.gguf

PARAMETER temperature 0.2
PARAMETER num_ctx 8192
