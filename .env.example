# Sao chép file này thành .env rồi điền giá trị.  KHÔNG commit file .env.
#   cp .env.example .env

# ================= Backend: model sinh câu trả lời =================
# mock   : trả lời giả, không cần gì (mặc định, để dev UI/BE)
# ollama : model chạy local bằng Ollama (model gốc hoặc model nhóm fine-tune)
LLM_PROVIDER=mock
LLM_MODEL=

# Ví dụ chạy model gốc (chưa fine-tune) để thử:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:7b
# Ví dụ chạy model nhóm đã fine-tune:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=chatbot-hust
# Ollama chạy trên máy khác cùng mạng: đổi localhost thành IP máy đó.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

MAX_ANSWER_TOKENS=1024

# ================= Truy xuất =================
# mock     : dùng data/samples/sample_chunks.jsonl
# supabase : dùng CSDL thật (cần chạy supabase/migrations/001_init.sql trước)
RETRIEVER=mock
TOP_K=6
EMBED_MODEL=BAAI/bge-m3

# Lấy ở Supabase Dashboard -> Project Settings -> API (dùng service_role key, chỉ để ở backend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ================= Web =================
CORS_ORIGINS=*
MIN_SECONDS_BETWEEN_QUESTIONS=2
ADMIN_TOKEN=
