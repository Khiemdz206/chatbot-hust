# Sao chép file này thành .env rồi điền giá trị.  KHÔNG commit file .env.
#   cp .env.example .env

# ================= Backend: model sinh câu trả lời =================
# mock          : trả lời giả, không cần key (mặc định, để dev UI/BE)
# anthropic     : phương án A với API Anthropic
# openai_compat : phương án A với OpenAI/API cùng chuẩn, HOẶC phương án B (Ollama/vLLM)
LLM_PROVIDER=mock
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ví dụ phương án A (Anthropic):
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-opus-5-5
# Ví dụ phương án B (model fine-tune chạy bằng Ollama trên máy):
#   LLM_PROVIDER=openai_compat
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=chatbot-hust

MAX_ANSWER_TOKENS=1024

# ================= Truy xuất =================
# mock     : dùng data/samples/sample_chunks.jsonl
# supabase : dùng CSDL thật (cần chạy supabase/migrations/001_init.sql trước)
RETRIEVER=mock
TOP_K=6
EMBED_MODEL=BAAI/bge-m3

# Lấy ở Supabase Dashboard -> Project Settings -> API (dùng service_role key, chỉ để ở backend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ================= Web =================
CORS_ORIGINS=*
MIN_SECONDS_BETWEEN_QUESTIONS=2
ADMIN_TOKEN=

# ================= Script dùng model mạnh (data/, finetune/, eval/) =================
# Mỗi vai trò chọn provider + model riêng. API key dùng chung ở trên.
TEACHER_PROVIDER=anthropic
TEACHER_MODEL=
JUDGE1_PROVIDER=anthropic
JUDGE1_MODEL=
JUDGE2_PROVIDER=openai_compat
JUDGE2_MODEL=
# JUDGE2_BASE_URL=https://api.openai.com/v1
